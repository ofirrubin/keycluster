# ============================================================================
# Domain Manager -- Environment Variables
# ============================================================================
# Copy this file to .env and replace placeholder values before running.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Async PostgreSQL connection string used by SQLModel / SQLAlchemy.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://keycloak:changeme@localhost:5432/keycloak

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
# Internal URL where the domain-manager can reach Keycloak.
KEYCLOAK_SERVER_URL=http://localhost:8080

# Realm used for authenticating domain-manager API callers.
KEYCLOAK_REALM=master

# (Optional) OIDC client ID for audience validation.
# Leave empty to skip aud/azp checks.
KEYCLOAK_CLIENT_ID=

# Admin credentials used to obtain a Keycloak admin token for realm
# management operations (patching security headers, creating roles, etc.).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Authorization
# ---------------------------------------------------------------------------
# Comma-separated list of Keycloak realm roles that grant admin access
# to the domain-manager API.
ADMIN_ROLES=admin,keycluster-admin,realm-admin

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Origin allowed to call the API from a browser. Use a specific origin in
# production (e.g., https://admin.yourdomain.com). Defaults to "*".
CORS_ALLOWED_ORIGIN=*
